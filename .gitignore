# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/

# Local game-data clone — regenerate with pipeline/parse_dumps.py, never commit
# (it is ~150 MB of Sandbox Interactive's client data)
ao-bin-dumps/

# Tier-2 blind-test responses may contain other people's names; keep them local
tests/tier2_form_filled*.md
tests/*_responses.md

# NOTE: pipeline/out/*.json IS committed on purpose. It is the parsed game data
# the engine, lint and dashboard all read, it is small (~600 KB total), and
# committing it means the project runs without a 150 MB clone.
.playwright-mcp/
pipeline/out/icons/
pipeline/out/party_cache/
# the killer-party cache: one SQLite file plus its write-ahead log; the
# per-battle JSON files it replaced are set aside by migrate_party_cache.py
pipeline/out/party_cache.sqlite*
pipeline/out/party_cache_files_migrated/
pipeline/out/dumps_cache/
pipeline/out/fetch_logs/
# the plain artifact is history: the harvest writes party_rosters.json.gz (2026-09-11)
pipeline/out/party_rosters.json
# the killer-party artifacts are derived from the cache and stay local
# (rosters_io, LOCAL FILES, ONE COMMITTED RECORD): the harvest's working
# copies, the fold's sealed copies and the previous fold's copy; the
# fold's record, out/rosters_fold.json, is committed
pipeline/out/party_rosters.json.gz
pipeline/out/party_rosters_full.json.gz
pipeline/out/party_rosters.fold.json.gz
pipeline/out/party_rosters_full.fold.json.gz
pipeline/out/party_rosters.fold-prev.json.gz
pipeline/out/party_rosters*.tmp
# the harvest backup's target folder (backup_harvest.py), one per machine
pipeline/harvest_backup.json

# derive_meta_prior.py --all-battles audit copy (never shipped)
pipeline/out/meta_prior-all-battles.json

# fit_choice_weights.py extraction shards (large, regenerated by `extract`)
pipeline/out/choice_fit/

# curation review boards (build_stat_chart.py, build_magnitude_review.py) are local
review/

# test-only npm installs (npm install --no-save; see tests/test_supabase_rls.mjs)
node_modules/
